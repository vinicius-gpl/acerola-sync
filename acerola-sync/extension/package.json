{
	"name": "acerola-sync-extension",
	"type": "module",
	"version": "1.0.2",
	"private": true,
	"license": "MPL-2.0",
	"author": {
		"name": "Vinícius Gabriel Pereira Leitão",
		"email": "contact@acerola.app"
	},
	"description": "Extensão do Acerola Sync — lista, lançamentos e tracking de anime e mangá.",
	"scripts": {
		"dev": "npm run paraglide:compile && wxt",
		"dev:firefox": "npm run paraglide:compile && wxt -b firefox",
		"build": "npm run paraglide:compile && wxt build",
		"build:firefox": "npm run paraglide:compile && wxt build -b firefox",
		"zip": "npm run paraglide:compile && wxt zip",
		"zip:firefox": "npm run paraglide:compile && wxt zip -b firefox",
		"postinstall": "wxt prepare",
		"check": "npm run paraglide:compile && wxt prepare && svelte-check --tsconfig ./tsconfig.json",
		"storybook": "npm run paraglide:compile && storybook dev -p 6006",
		"build-storybook": "npm run paraglide:compile && storybook build",
		"paraglide:compile": "paraglide-js compile --project ./svelte/project.inlang --outdir ./svelte/src/lib/paraglide",
		"test": "npm run paraglide:compile && vitest run --project=unit",
		"test:watch": "npm run paraglide:compile && vitest --project=unit",
		"test:coverage": "npm run paraglide:compile && vitest run --project=unit --coverage",
		"test:storybook": "npm run paraglide:compile && vitest run --project=storybook",
		"test:e2e": "npm run build && playwright test",
		"test:mutation": "npm run paraglide:compile && stryker run",
		"lint": "prettier --check .",
		"format": "prettier --write ."
	},
	"dependencies": {
		"@formkit/auto-animate": "^0.10.0",
		"gsap": "^3.15.1"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "^5.2.1",
		"@fontsource-variable/dm-sans": "^5.2.8",
		"@fontsource-variable/noto-serif": "^5.2.9",
		"@inlang/paraglide-js": "^3.1.0",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.68.0",
		"@playwright/test": "^1.64.1",
		"@poppanator/sveltekit-svg": "^7.0.1",
		"@storybook/addon-a11y": "^10.6.5",
		"@storybook/addon-docs": "^10.6.5",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/addon-vitest": "^10.6.5",
		"@storybook/svelte-vite": "^10.6.5",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.4",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^26.6.6",
		"@vitest/browser-playwright": "^5.1.0",
		"@vitest/coverage-v8": "^5.1.0",
		"@wxt-dev/module-svelte": "^2.0.5",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"jsdom": "^30.1.3",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.64.1",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"shadcn-svelte": "^1.8.0",
		"storybook": "^10.5.10",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^4.0.1",
		"tailwindcss": "^4.1.18",
		"tw-animate-css": "^1.4.0",
		"typescript": "~7.0.2",
		"vite": "^8.3.6",
		"vitest": "^5.1.0",
		"vitest-browser-svelte": "^3.0.0",
		"wxt": "^0.21.5"
	}
}
