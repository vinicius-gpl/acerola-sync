# Copie para `.env` e preencha. O `.env` nunca vai para o git.
DATABASE_URL=postgres://acerola:acerola@localhost:5432/acerola_sync
SERVER_PORT=3010
RUST_LOG=info

# Chave AES-256 em base64 que criptografa o token do AniList no banco.
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=

# Client ID do app cadastrado no AniList (https://anilist.co/settings/developer).
# O redirect cadastrado lá é a URL que a tela de login da extensão mostra.
# O Client Secret não é usado.
ANILIST_CLIENT_ID=

# Opcional: trava a instância no seu usuário do AniList. Sem ela, o primeiro login vira o dono.
ALLOWED_ANILIST_USER_ID=

# Opcional: só muda em teste.
# ANILIST_API_URL=https://graphql.anilist.co
