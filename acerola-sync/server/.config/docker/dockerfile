# syntax=docker/dockerfile:1
#
# A single image, with the server binary. The extension is not here: it is packaged by WXT
# and published in the stores, not served by the container.
#
# Build context: the server folder (see .config/docker/compose.yml). In production it sits
# behind the server's Caddy, which handles domain and TLS (.config/ansible).

FROM rust:1.100-bookworm AS build
WORKDIR /repo/server
COPY Cargo.toml Cargo.lock ./
COPY src src
RUN --mount=type=cache,id=acerola-sync-cargo,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=acerola-sync-target,target=/repo/server/target,sharing=locked \
    cargo build --release --locked \
    && cp target/release/acerola-sync /usr/local/bin/acerola-sync

FROM debian:bookworm-slim AS app
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/acerola-sync /usr/local/bin/acerola-sync
USER nobody
EXPOSE 3010
CMD ["acerola-sync"]
