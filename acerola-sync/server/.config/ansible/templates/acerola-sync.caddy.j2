# Gerado pelo Ansible (server/.config/ansible/deploy.yml) a partir do `domain` do hosts.ini.
{{ domain }} {
    header {
        Strict-Transport-Security "max-age=31536000;"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    reverse_proxy acerola-sync-server:3010

    encode zstd gzip

    log {
        output file /data/acerola-sync-access.log
        format json
    }
}
